<html>
<head>
<title>ObjectNotifications</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ObjectNotifications</td></tr>
</thead>

<tbody>
<tr>
	<td>NOTIFICATION_TEMPLATE_INPUT</td>
	<td>//div[@class= 'form-group']//input[@name= '${key_inputName}']</td>
	<td></td>
</tr>
<tr>
	<td>NOTIFICATION_TEMPLATE</td>
	<td>//div[@class= 'table-list-title' and contains(., '${key_notificationTemplateName}')]</td>
	<td></td>
</tr>
<tr>
	<td>DROPDOW_MENU</td>
	<td>//div[@class='table-list-title' and contains(., '${key_templateName}')]//..//..//button[@class='dropdown-toggle component-action dropdown-toggle ml-1 btn btn-unstyled']</td>
	<td></td>
</tr>
<tr>
	<td>DROPDOW_MENU_ITEM</td>
	<td>//div[@class='dropdown-menu show']//button[@class='dropdown-item' and contains(., '${key_menuItem}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>