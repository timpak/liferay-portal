definition {

	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Object";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();
	}

	tearDown {
		ObjectAdmin.deleteAllCustomObjectsViaAPI();

		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "LPS-186234 - Verify is possible to add entries of the encrypted object fields"
	@priority = 5
	test CanAddEntry {
		property custom.properties = PropsUtil.get("object.encryption.algorithm");
		property custom.properties = PropsUtil.get("object.encryption.key");
		property portal.acceptance = "true";

		task ("Given a custom object with an encrypted field") {
			ObjectAdmin.addObjectViaAPI(
				labelName = "Custom Object 186234",
				objectName = "CustomObject186234",
				pluralLabelName = "Custom Objects 186234");

			ObjectAdmin.openObjectAdmin();

			ObjectPortlet.selectCustomObject(label = "Custom Object 186234");

			ObjectAdmin.goToFieldsTab();

			ObjectAdmin.addObjectFieldViaUI(
				fieldLabel = "Encrypted Field",
				fieldName = "encryptedField",
				fieldType = "Encrypted");

			ObjectAdmin.publishObjectViaAPI(objectName = "CustomObject186234");
		}

		task ("When the user adds an entry") {
			ObjectAdmin.goToCustomObject(objectName = "CustomObject186234");

			ObjectAdmin.addObjectStringFieldEntryViaUI(entryValue = "Entry Test");
		}

		task ("Then the field value is decrypted on the table") {
			Navigator.gotoBack();

			ObjectPortlet.viewEntry(entry = "Entry Test");
		}
	}

	@description = "LPS-186235 - Verify is possible to update entries of the encrypted object fields"
	@priority = 5
	test CanUpdateEntry {
		property custom.properties = PropsUtil.get("object.encryption.algorithm");
		property custom.properties = PropsUtil.get("object.encryption.key");
		property portal.acceptance = "true";

		task ("Given a custom object with an encrypted field and an object entry") {
			ObjectAdmin.addObjectViaAPI(
				labelName = "Custom Object 186235",
				objectName = "CustomObject186235",
				pluralLabelName = "Custom Objects 186235");

			ObjectAdmin.addObjectFieldViaAPI(
				fieldBusinessType = "Encrypted",
				fieldLabelName = "Encrypted Field",
				fieldName = "encryptedField",
				fieldType = "Clob",
				indexed = "false",
				isRequired = "false",
				objectName = "CustomObject186235");

			ObjectAdmin.publishObjectViaAPI(objectName = "CustomObject186235");

			ObjectAdmin.addObjectSingleFieldEntryViaAPI(
				fieldName = "encryptedField",
				objectName = "CustomObject186235",
				value = "Entry Test");
		}

		task ("When the user edits the entry") {
			ObjectAdmin.goToCustomObject(objectName = "CustomObject186235");

			ObjectPortlet.viewEntryDetails(entry = "Entry Test");

			ObjectPortlet.typeCustomField(
				customField = "Encrypted Field",
				entry = "Edited Entry");

			Button.clickSave();
		}

		task ("Then the field value is decrypted and the value is updated on the table") {
			AssertElementPresent(
				locator1 = "ObjectAdmin#ENTRY_STRING_VALUE_FIELD",
				value1 = "Edited Entry");

			ObjectAdmin.goToCustomObject(objectName = "CustomObject186235");

			ObjectPortlet.viewEntry(entry = "Edited Entry");
		}
	}

	@description = "LPS-186236 - Verify the field value is decrypted in collection display"
	@priority = 4
	test CanViewEntryWithCollectionDisplay {
		property custom.properties = PropsUtil.get("object.encryption.algorithm");
		property custom.properties = PropsUtil.get("object.encryption.key");

		task ("Given an object with an encrypted field and an object entry") {
			ObjectAdmin.addObjectViaAPI(
				labelName = "Custom Object 186236",
				objectName = "CustomObject186236",
				pluralLabelName = "Custom Objects 186236");

			ObjectAdmin.addObjectFieldViaAPI(
				fieldBusinessType = "Encrypted",
				fieldLabelName = "Encrypted Field",
				fieldName = "encryptedField",
				fieldType = "Clob",
				indexed = "false",
				isRequired = "false",
				objectName = "CustomObject186236");

			ObjectAdmin.publishObjectViaAPI(objectName = "CustomObject186236");

			ObjectAdmin.addObjectSingleFieldEntryViaAPI(
				fieldName = "encryptedField",
				objectName = "CustomObject186236",
				value = "Entry Test");
		}

		task ("And given a page with a collection display") {
			ContentPages.addPage(pageName = "Blank Display Page");

			PageEditor.addFragment(
				collectionName = "Content Display",
				fragmentName = "Collection Display");
		}

		task ("And given select the object as a collection provider using a display style as Table") {
			PageEditor.editCollectionDisplay(
				fragmentName = "Collection Display",
				infoListProviderName = "Custom Objects 186236",
				styleDisplay = "Table");

			Button.clickPublish();
		}

		task ("When go to the created page") {
			Navigator.gotoPage(pageName = "Blank Display Page");
		}

		task ("Then the field value is decrypted on the table") {
			AssertElementPresent(
				key_entryName = "Entry Test",
				locator1 = "ObjectAdmin#VIEW_ENTRY_NAME_ON_PAGE");
		}
	}

}